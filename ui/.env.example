# Copiá este archivo a .env y completá con tu connection string real.
# Nunca commitees el .env con credenciales reales — .gitignore ya lo excluye.

# Local con Postgres en Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pitstop_ai"

# Supabase: necesitás DOS urls. Las encontrás en el botón "Connect" del
# dashboard → pestaña "ORMs" → Prisma (ahí Supabase ya te arma las dos
# líneas con el host/región/usuario correctos, solo pegás tu contraseña).
#
# DATABASE_URL = "Transaction pooler" (puerto 6543) — la usa la app en runtime
#                 vía @prisma/adapter-pg. Agregale ?pgbouncer=true.
# DIRECT_URL   = "Session pooler" (puerto 5432) — la usa prisma.config.ts
#                 para `prisma migrate`, porque el transaction pooler no
#                 soporta prepared statements.
#
# Nota: si tu contraseña tiene caracteres especiales (@ : / # % etc.),
# codificalos en formato URL (ej. "@" → "%40") o la conexión va a fallar
# por parsing.
DATABASE_URL="postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres"

# WhatsApp Cloud API (Meta) — el chat de prediagnóstico entra por acá, no
# por la UI. Se configura gratis con una cuenta de Meta for Developers:
# developers.facebook.com → tu app → WhatsApp → Getting Started te da un
# número de prueba, el WHATSAPP_TOKEN temporal y el WHATSAPP_PHONE_NUMBER_ID.
# (el free tier de Meta incluye 1000 conversaciones/mes, sin tarjeta).
#
# Nota: si terminan usando Twilio en vez de Meta, estas variables cambian
# por TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_NUMBER — ver
# lib/whatsapp.ts para la versión que esté activa en el código.

# Token de acceso de la app de Meta (temporal de 24hs en modo prueba;
# para uno permanente hay que generar un token de sistema).
WHATSAPP_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ID del número de WhatsApp de prueba/producción (Meta → WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# String que vos inventás y pegás también en el panel de Meta al configurar
# el webhook (Meta te lo va a devolver en el handshake de verificación).
WHATSAPP_VERIFY_TOKEN="elegí-un-string-random-acá"

# "App secret" de tu app de Meta (Configuración básica de la app). Se usa
# para verificar que los webhooks entrantes son realmente de Meta.
WHATSAPP_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Motor de diagnóstico (LLM) — cliente genérico compatible con OpenAI, así
# que sirve para Groq, Gemini, OpenAI, Together.ai, etc. sin cambiar código.
#
# Default recomendado: Groq (console.groq.com) — tier gratuito real, sin
# tarjeta, modelos Llama rápidos y de buena calidad para este caso de uso.
LLM_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"

# Si en vez de Groq usan Gemini (también tiene free tier), sería algo así:
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL="gemini-2.0-flash"
