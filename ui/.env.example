# Base de datos (Supabase/Postgres)
# DATABASE_URL: transaction pooler (puerto 6543) — la usa la app en runtime.
# DIRECT_URL: session pooler (puerto 5432) — la usa Prisma CLI (migrate, studio, seed).
DATABASE_URL=""
DIRECT_URL=""

# Gemini (free tier) — API key en aistudio.google.com/apikey
GEMINI_API_KEY=""

# Twilio — WhatsApp Sandbox (console.twilio.com)
# Account SID y Auth Token están en el Dashboard principal.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Opcional: si autenticás con API Key en vez de Auth Token (Account → API keys & tokens).
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Número del sandbox de WhatsApp, formato "whatsapp:+14155238886".
TWILIO_WHATSAPP_NUMBER=""
