# Copiá este archivo a .env y completá con tu connection string real.
# Nunca commitees el .env con credenciales reales — .gitignore ya lo excluye.

# Local con Postgres en Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pitstop_ai"

# Supabase: necesitás DOS urls. Las encontrás en el botón "Connect" del
# dashboard → pestaña "ORMs" → Prisma (ahí Supabase ya te arma las dos
# líneas con el host/región/usuario correctos, solo pegás tu contraseña).
#
# DATABASE_URL = "Transaction pooler" (puerto 6543) — la usa la app en runtime
#                 vía @prisma/adapter-pg. Agregale ?pgbouncer=true.
# DIRECT_URL   = "Session pooler" (puerto 5432) — la usa prisma.config.ts
#                 para `prisma migrate`, porque el transaction pooler no
#                 soporta prepared statements.
#
# Nota: si tu contraseña tiene caracteres especiales (@ : / # % etc.),
# codificalos en formato URL (ej. "@" → "%40") o la conexión va a fallar
# por parsing.
DATABASE_URL="postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres"

# Telegram Bot API — el chat de prediagnóstico entra por acá, no por la UI.
# Token de @BotFather (comando /newbot en Telegram).
TELEGRAM_BOT_TOKEN=""
# Cadena random propia (no la da Telegram) para validar que el webhook viene
# de Telegram — se manda como `secret_token` al registrar el webhook y
# Telegram la reenvía en el header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""

# Motor de diagnóstico (LLM) — cliente genérico compatible con OpenAI, así
# que sirve para Gemini, Groq, OpenAI, Together.ai, etc. sin cambiar código
# (ver lib/services/llm.ts).
#
# Default recomendado: Gemini (aistudio.google.com/apikey) — free tier real
# (15 RPM / 1500 mensajes por día), sin tarjeta, probado funcionando en este
# proyecto.
LLM_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemini-2.5-flash"

# Si en vez de Gemini usan Groq (también tiene free tier), sería algo así:
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="llama-3.3-70b-versatile"
