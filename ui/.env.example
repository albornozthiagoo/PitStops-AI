# Base de datos (Supabase/Postgres)
# DATABASE_URL: transaction pooler (puerto 6543) — la usa la app en runtime.
# DIRECT_URL: session pooler (puerto 5432) — la usa Prisma CLI (migrate, studio, seed).
DATABASE_URL=""
DIRECT_URL=""

# Gemini (free tier) — API key en aistudio.google.com/apikey
GEMINI_API_KEY=""

# Telegram Bot API — token de @BotFather (comando /newbot en Telegram)
TELEGRAM_BOT_TOKEN=""
# Cadena random propia (no la da Telegram) para validar que el webhook viene
# de Telegram — se manda como `secret_token` al registrar el webhook y
# Telegram la reenvía en el header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""
